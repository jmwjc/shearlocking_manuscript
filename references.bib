@article{zou2026,
  title = {Modeling and Design of Curved Thin-Walled {{Voronoi}} Lattice Infill Structures for Stiffness Robustness and Buckling Performance},
  author = {Zou, Binze and Yang, Rui and Niu, Bin},
  year = 2026,
  month = oct,
  journal = {Computer Methods in Applied Mechanics and Engineering},
  volume = {460},
  pages = {119094},
  issn = {0045-7825},
  doi = {10.1016/j.cma.2026.119094},
  urldate = {2026-05-26},
  abstract = {Curved thin-walled lattice structures have been increasingly explored for lightweight engineering applications. Voronoi lattice structures have been adopted for two-dimensional (2D) planar and three-dimensional (3D) spatial structures owing to their ability to preserve the mechanical performance under load uncertainty and structural defects. In addition, smooth density grading within the lattice structures can be achieved by adjusting the distribution of the Voronoi sites. In this work, a modeling and design method for the curved thin-walled Voronoi infilled lattice structures is proposed for the stiffness robustness and the buckling performance. First, an implicit Voronoi microstructure is obtained based on a Voronoi diagram constructed as the dual of a triangulation, and the equivalent elastic properties are calculated using the stiffness prediction method for the Voronoi lattices with in-plane periodicity. Second, the stiffness robustness and the buckling performance of the Voronoi lattice structures are analyzed. Then, a design optimization model for the stiffness robustness with a buckling constraint is established. Moreover, according to the optimization results, 3D curved thin-walled Voronoi lattice structures are constructed based on the conformal mapping method. The generated structure serves as a 3D discretized mesh model suitable for finite element analysis and additive manufacturing. Finally, the effectiveness of the proposed method for the stiffness robustness and the buckling performance design is verified through numerical examples. The stiffness robustness and the buckling performance are discussed for structures with random local defects, and the effects of the optimization parameters and the microstructure types on the mechanical performance are also investigated.}
}
